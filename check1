require 'spec_helper'
require 'puppet/functions/check_mk/get_site_info'
require 'net/http'
require 'uri'

describe 'check_mk::get_site_info' do
  let(:fqdn) { 'example.com' }
  let(:base_url) { 'api.example.net' }
  let(:env) { 'prod' }
  let(:uri) { URI("https://#{base_url}/api/1.0/get_site_info?host_name=#{fqdn}&env=#{env}&format=json") }

  it { is_expected.to run.with_params(fqdn, base_url, env).and_return_a_kind_of(Hash) }

  context 'when API returns valid JSON' do
    let(:response_body) do
      {
        'status' => 'success',
        'site' => 'example-site',
        'fqdn' => fqdn,
        'message' => 'Site info retrieved successfully'
      }.to_json
    end

    let(:response) { instance_double(Net::HTTPOK, body: response_body, code: '200') }

    before(:each) do
      allow(Net::HTTP).to receive(:get_response).and_return(response)
    end

    it 'returns the expected hash' do
      is_expected.to run.with_params(fqdn, base_url, env).and_return(
        'status' => 'success',
        'site' => 'example-site',
        'fqdn' => fqdn,
        'message' => 'Site info retrieved successfully'
      )
    end
  end

  context 'when API returns invalid JSON' do
    let(:response_body) { 'Invalid JSON' }

    let(:response) { instance_double(Net::HTTPOK, body: response_body, code: '200') }

    before(:each) do
      allow(Net::HTTP).to receive(:get_response).and_return(response)
    end

    it 'returns an error hash' do
      is_expected.to run.with_params(fqdn, base_url, env).and_return(
        'status' => 200,
        'site' => '',
        'fqdn' => fqdn,
        'message' => /Failed to parse response/
      )
    end
  end

  context 'when API returns an error' do
    let(:response) { instance_double(Net::HTTPInternalServerError, body: '', code: '500') }

    before(:each) do
      allow(Net::HTTP).to receive(:get_response).and_return(response)
    end

    it 'returns an error hash' do
      is_expected.to run.with_params(fqdn, base_url, env).and_return(
        'status' => 500,
        'site' => '',
        'fqdn' => fqdn,
        'message' => /Failed to parse response/
      )
    end
  end
end
