# spec/unit/functions/get_site_info_spec.rb
require 'spec_helper'
require 'puppet/functions/check_mk/get_site_info'

describe Puppet::Functions::CheckMk::GetSiteInfo do
  let(:fqdn) { 'example.com' }
  let(:base_url) { 'https://checkmk.example.com' }
  let(:env) { 'prod' }
  let(:instance) { described_class.new }

  it 'returns a hash with site information' do
    allow(instance).to receive(:http_get).and_return(
      {
        'status' => 'OK',
        'site' => 'example_site',
        'fqdn' => fqdn,
        'message' => 'Site is up and running',
      },
    )

    result = instance.execute(fqdn, base_url, env)
    expect(result).to eq(
      'status' => 'OK',
      'site' => 'example_site',
      'fqdn' => fqdn,
      'message' => 'Site is up and running',
    )
  end

  it 'handles JSON parsing errors' do
    allow(instance).to receive(:http_get).and_raise(JSON::ParserError, 'JSON parsing error')

    result = instance.execute(fqdn, base_url, env)
    expect(result).to include(
      'status' => nil,
      'site' => '',
      'fqdn' => fqdn,
      'message' => %r{Failed to parse response: JSON parsing error},
    )
  end

  it 'handles HTTP errors' do
    allow(instance).to receive(:http_get).and_return(
      {
        'status' => 404,
        'site' => '',
        'fqdn' => fqdn,
        'message' => 'Site not found',
      },
    )

    result = instance.execute(fqdn, base_url, env)
    expect(result).to include(
      'status' => 404,
      'site' => '',
      'fqdn' => fqdn,
      'message' => %r{Failed to retrieve site info: Site not found},
    )
  end
end
